<div id="egg4" style="display:none">
  <div class="egg-bd big fit">
    <button class="egg-x" onclick="eggBackToMenu()">✕</button>
    <button class="egg-snd" onclick="eggToggleMute()" aria-label="Toggle sound (M)"></button>
