          <circle cx="599.5" cy="22" r="1.5" fill="#e2d9ff"/><circle cx="611.2" cy="36.6" r="1.4" fill="#e2d9ff"/><circle cx="611.5" cy="48.5" r="1.5" fill="#e2d9ff"/><circle cx="613.6" cy="63.2" r="1" fill="#cbb8ff"/><circle cx="605.1" cy="72.3" r="1.3" fill="#cbb8ff"/><circle cx="617" cy="90.5" r="1.3" fill="#cbb8ff"/><circle cx="630.4" cy="85" r="1.6" fill="#e2d9ff"/>
