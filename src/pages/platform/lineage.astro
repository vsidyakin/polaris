---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { node } from "../../lib/pages/platform-lineage";
import CtaBand from "../../components/CtaBand.astro";
import { stars } from "../../lib/blocks";
import PageIntro from "../../components/PageIntro.astro";
---

<BaseLayout route="platform/lineage">
  <PageIntro
    route={"platform/lineage"}
    tpl={"T9"}
    title={"Fifteen years, one platform story."}
    dek={"Mersive Solstice taught the market wireless collaboration. Mersive Polaris is what it grew into: same mission, same sky, next platform generation. This page is the story; if you&rsquo;re ready to move your rooms, the <a href=\"/products/transition\">transition path</a> is the plan."}
  />

    <div class="linwrap reveal"><Fragment set:html={stars(26)} />
      <svg viewBox="0 0 780 210" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Timeline: Mersive Sol 2012, Solstice Gen 1 2013, Gen 2 2015, Gen 2i 2017, Gen 3 2019, to Mersive Polaris 2026, drawn over the real northern sky with Polaris at the final milestone">
        <defs><linearGradient id="ling1" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#4a3d7d"/><stop offset=".62" stop-color="#8f7ae0"/><stop offset="1" stop-color="#7ce3a8"/></linearGradient></defs>
        <!-- The north-polar group (Ursa Minor, Ursa Major, Draco, Cepheus,
             Cassiopeia) carries catalogue positions: HYG v4.1 J2000, projected
             stereographically about the pole and mapped in by a single
             similarity transform pinned so Polaris lands exactly on the node the
             timeline hangs from. Everything further out is a strip map, which
             stops being one projection, so those figures stay as drawn. -->
        <g class="lin-sky" transform="translate(700 62) scale(1.14) translate(-700 -62)">
          <!-- declination arcs: the polar-chart grid, faint -->
          <circle cx="700" cy="62" r="52" fill="none" stroke="#8a7fb8" stroke-width=".7" opacity=".12" stroke-dasharray="1 5"/>
          <circle cx="700" cy="62" r="104" fill="none" stroke="#8a7fb8" stroke-width=".7" opacity=".10" stroke-dasharray="1 5"/>
          <circle cx="700" cy="62" r="156" fill="none" stroke="#8a7fb8" stroke-width=".7" opacity=".08" stroke-dasharray="1 5"/>
          <!-- URSA MINOR: handle from the pole star (the green node) to the bowl -->
          <path d="M700 62 L696.6 52.7 L690.4 42.7 L679 37.3 M679 37.3 L680 30.3 L665.9 28.7 L666.7 36.8 L679 37.3" fill="none" stroke="#8a7fb8" stroke-width=".8" opacity=".5"/>
          <circle cx="696.6" cy="52.7" r=".9" fill="#cbb8ff"/><circle cx="690.4" cy="42.7" r=".9" fill="#cbb8ff"/><circle cx="679" cy="37.3" r="1" fill="#cbb8ff"/><circle cx="680" cy="30.3" r=".8" fill="#8a7fb8"/><circle cx="665.9" cy="28.7" r="1.2" fill="#e2d9ff"/><circle cx="666.7" cy="36.8" r="1.5" fill="#e2d9ff"/>
