          <circle cx="747.3" cy="10.9" r="1.4" fill="#e2d9ff"/><circle cx="734.3" cy="27.4" r="1.1" fill="#cbb8ff"/><circle cx="729" cy="55.3" r="1.1" fill="#cbb8ff"/><circle cx="754.1" cy="37.5" r="1" fill="#8a7fb8"/><circle cx="767.3" cy="17" r="1" fill="#cbb8ff"/>
